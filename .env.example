# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY=""

# Multi-Provider Fallback Configuration
# Secondary API key used automatically when Gemini encounters 503 high demand, 429 rate limit, or network errors.
# Supports OpenAI (sk-...), OpenRouter (sk-or-...), Groq (gsk_...), or a secondary Gemini key (AIza...).
VITE_FALLBACK_API_KEY=""
FALLBACK_API_KEY=""
# Optional custom base URL (e.g., https://api.openai.com/v1, https://openrouter.ai/api/v1, https://api.groq.com/openai/v1)
VITE_FALLBACK_BASE_URL=""
# Optional fallback model name (e.g., gpt-4o-mini, llama-3.3-70b-versatile, etc.)
VITE_FALLBACK_MODEL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database Server Configuration
VITE_POCKETBASE_URL="https://temple-plc-merchandise-blocking.trycloudflare.com"
